# Database (matches docker-compose.yaml)
DB_URL=jdbc:postgresql://localhost:5434/flyaway
DB_USERNAME=postgres
DB_PASSWORD=postgres

# JWT - use a random string of at least 32 characters
JWT_SECRET=change-me-to-a-random-secret-of-32-chars-or-more
JWT_EXPIRATION_MS=3600000

# Folder for the flight_booking_email_${booking_id}.txt confirmation files
BOOKING_EMAIL_DIR=.
